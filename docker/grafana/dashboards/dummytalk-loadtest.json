{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "DummyTalk · K6 부하테스트 (open model)",
  "uid": "dummytalk-loadtest",
  "description": "c7g.large 재측정용. 뽑기 URI 고정, 서버측 분위수·히트맵, 포화 순서(% of capacity), VT 대체 지표. 회차 창은 k6 결과 파일의 시작~종료로 맞출 것.",
  "tags": [
    "dummytalk",
    "k6",
    "loadtest"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "uri",
        "label": "URI",
        "type": "custom",
        "hide": 0,
        "query": "/api/dummies/dummy,/api/members/login,/api/dummies/quiz",
        "current": {
          "text": "/api/dummies/dummy",
          "value": "/api/dummies/dummy"
        },
        "options": [
          {
            "text": "/api/dummies/dummy",
            "value": "/api/dummies/dummy",
            "selected": true
          },
          {
            "text": "/api/members/login",
            "value": "/api/members/login",
            "selected": false
          },
          {
            "text": "/api/dummies/quiz",
            "value": "/api/dummies/quiz",
            "selected": false
          }
        ],
        "description": "측정 대상 엔드포인트. Micrometer uri 태그(경로 템플릿) 기준."
      },
      {
        "name": "rate_window",
        "label": "rate 창",
        "type": "custom",
        "hide": 0,
        "query": "15s,30s,1m",
        "current": {
          "text": "30s",
          "value": "30s"
        },
        "options": [
          {
            "text": "15s",
            "value": "15s",
            "selected": false
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": true
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          }
        ],
        "description": "rate()/histogram_quantile 창. 스크레이프 1s 기준 15s 이상. 좁을수록 민감, 넓을수록 매끈."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "1. 부하 · 처리량  (도착률 vs 처리율 — k6 RATE 와 처리 rps 가 벌어지면 밀리기 시작)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "처리 rps by status  (200=뽑기 성공 · 429=거절 · 400=한도 · 5xx=오류)",
      "description": "Tomcat 이 응답을 완료한 초당 건수. 스택 합 = 실제 처리율. k6 의 RATE(도착률)보다 낮아지는 지점이 포화 시작.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "429"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "400"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=\"$uri\"}[$rate_window]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "In-flight 요청 수  (서버 안에 머무는 요청 — VT 모드에서도 유효)",
      "description": "Micrometer LongTaskTimer(http.server.requests.active)의 gcount = 지금 처리 중인 요청 수. 핸들러 매칭 전에 시작돼 uri 라벨이 UNKNOWN 이므로 URI 필터 없이 합산한다(실측 확인). Tomcat 스레드 지표는 VT executor 로 바꾸면 -1 이 되지만 이 값은 요청 단위라 살아있다. 도착률 × 지연 ≈ in-flight (Little's law).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(http_server_requests_active_seconds_gcount)",
          "legendFormat": "in-flight (전체 URI)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "429 비율 (창 Max)",
      "description": "open model 에선 '직전 요청이 INTERVAL 안에 안 끝남' = 서버측 지연 > 주기. 오르기 시작한 rate 가 실질 상한.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"$uri\",status=\"429\"}[$rate_window])) or vector(0)) / sum(rate(http_server_requests_seconds_count{uri=\"$uri\"}[$rate_window]))",
          "legendFormat": "429",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "5xx 비율 (창 Max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"$uri\",status=~\"5..\"}[$rate_window])) or vector(0)) / sum(rate(http_server_requests_seconds_count{uri=\"$uri\"}[$rate_window]))",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "200 처리 rps (창 Max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"$uri\",status=\"200\"}[$rate_window]))",
          "legendFormat": "200 rps",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 7,
      "title": "2. 서버측 지연 (RTT 제외 — Tomcat 수신 → 응답 완료)  ※ 전략 비교는 이 값으로",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "p50 / p95 / p99 / max  ($uri, 전 status 합산)",
      "description": "histogram_quantile 은 버킷 경계 사이를 선형 보간한다 — 값 자체보다 회차 간 추세 비교에 쓸 것. k6 teardown 의 pooled 분위수와 산출 방식이 다르므로 둘 다 기록한다 (CLAUDE_INIT 수치 해석 규칙).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max (스크레이프 창)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"$uri\"}[$rate_window])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"$uri\"}[$rate_window])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"$uri\"}[$rate_window])))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(http_server_requests_seconds_max{uri=\"$uri\"})",
          "legendFormat": "max (스크레이프 창)",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "지연 대역별 요청 비율  (느린 띠가 두꺼워지면 포화)",
      "description": "같은 히스토그램을 5개 대역으로 접은 것 — 히트맵(버킷 69개)은 띠가 뭉개져 읽기 어려워 대체했다. 안정 구간은 초록(≤16.8ms)이 대부분을 채우고, 포화되면 위쪽 대역이 아래에서부터 밀고 올라온다. p95 선(왼쪽 패널)이 '어디까지 느린가' 라면 이 패널은 '얼마나 많이 느린가' 를 본다. le 값은 Micrometer 기본 버킷 경계를 실측해 넣은 것이라 임의로 바꾸면 경계가 맞지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "≤ 16.8ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "16.8 ~ 112ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "112 ~ 537ms"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "537ms ~ 1.07s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "> 1.07s (꼬리)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"0.016777216\"}[$rate_window]))) / (sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"+Inf\"}[$rate_window])))",
          "legendFormat": "≤ 16.8ms",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"0.111848106\"}[$rate_window]))) - (sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"0.016777216\"}[$rate_window])))) / (sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"+Inf\"}[$rate_window])))",
          "legendFormat": "16.8 ~ 112ms",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"0.536870911\"}[$rate_window]))) - (sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"0.111848106\"}[$rate_window])))) / (sum(rate(http_server_requests_seconds_bucket{uri=\"$uri\",le=\"+Inf\"}[$rate_window])))",
          "legendFormat": "112 ~ 537ms",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
